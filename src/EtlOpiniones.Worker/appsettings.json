{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "OperationalDb": "Server=localhost;Database=OpinionesOperacionalDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Secrets": {
    "ComentariosApiKey": ""
  },
  "EtlSettings": {
    "IntervalMinutes": 60,
    "StagingDirectory": "staging",
    "Csv": {
      "Enabled": true,
      "FilePath": "samples/encuestas_internas.csv",
      "Delimiter": ","
    },
    "Database": {
      "Enabled": true,
      "ConnectionStringName": "OperationalDb",
      "Query": "SELECT IdResena, IdCliente, IdProducto, Fecha, Calificacion, TextoResena FROM ResenasClientes WHERE Procesado = 0",
      "CommandTimeoutSeconds": 30
    },
    "Api": {
      "Enabled": true,
      "BaseUrl": "https://jsonplaceholder.typicode.com/",
      "Endpoint": "comments?_limit=50",
      "ApiKeyHeader": "X-Api-Key",
      "TimeoutSeconds": 30
    }
  }
}
